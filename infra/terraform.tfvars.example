# Everything has a default in variables.tf (project, region, alert email, model, images).
# Override here only what differs. Pin images by running infra/build_images.sh, which
# writes infra/images.auto.tfvars; without it the images default to :latest.
project_id  = "weft-news-prod"
alert_email = "you@example.com"

# Email digest through Resend. Leave smtp_host empty to turn the digest off.
smtp_host = "smtp.resend.com"
smtp_user = "resend"
mail_from = "digest@your-verified-domain.example"
