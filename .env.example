# Copy to .env. Used only by docker-compose.yml (local testing).

# Model provider. All model calls go through weft_core's one client (rule 4).
MODEL_API_KEY=            # your OpenRouter key
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen3.6-35b-a3b
MODEL_REVISION=995ad96eacd98c81ed38be0c5b274b04031597b0
MODEL_PROVIDER=DeepInfra

# Password for the local Neo4j (the graph database).
NEO4J_PASSWORD=weft-local-pw

# Bearer token for the API admin endpoints (story public toggle, corrections).
ADMIN_TOKEN=local-admin-token

# Optional: email digest. Leave SMTP_HOST empty to skip the digest stage.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
