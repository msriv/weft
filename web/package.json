{
  "name": "weft-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "gen:types": "openapi-typescript lib/api.openapi.json -o lib/api.gen.ts",
    "gen:types:check": "openapi-typescript lib/api.openapi.json -o /tmp/api.gen.ts && diff -q /tmp/api.gen.ts lib/api.gen.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "i18n-iso-countries": "^7.14.0",
    "next": "^16.4.5",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.65.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
